{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-result.schema.json",
  "title": "Mercury ReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "bundle_revision",
    "bundle_sha256",
    "candidate_head",
    "review_mode",
    "remediation_finding_ids",
    "findings",
    "verdict"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_revision": {
      "type": "integer",
      "minimum": 1
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidate_head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "review_mode": {
      "enum": ["initial", "remediation"]
    },
    "remediation_finding_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "criterion_id",
          "introduced_by_candidate",
          "in_scope",
          "severity",
          "category",
          "disposition",
          "directly_caused_by_remediation",
          "evidence",
          "correction"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "criterion_id": {
            "type": ["string", "null"]
          },
          "introduced_by_candidate": {
            "type": "boolean"
          },
          "in_scope": {
            "type": "boolean"
          },
          "severity": {
            "enum": ["critical", "important", "minor"]
          },
          "category": {
            "enum": [
              "criterion_failure",
              "public_regression",
              "security",
              "data_loss",
              "protected_scope",
              "existing_issue",
              "adjacent_risk",
              "maintainability",
              "test_enhancement",
              "evidence_invalidated"
            ]
          },
          "disposition": {
            "enum": ["blocking", "follow_up", "accepted_risk"]
          },
          "directly_caused_by_remediation": {
            "type": "boolean"
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "correction": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verdict": {
      "enum": ["pass", "needs_changes", "blocked"]
    }
  }
}
