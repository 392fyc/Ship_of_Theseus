{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-bundle.schema.json",
  "title": "Mercury ReviewBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "bundle_revision",
    "target_head",
    "primary_deliverable",
    "change_kinds",
    "acceptance_criteria",
    "allowed_write_paths",
    "forbidden_paths",
    "impact_cone",
    "test_policy",
    "max_repair_rounds",
    "bundle_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "bundle_revision": {
      "type": "integer",
      "minimum": 1
    },
    "target_head": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "primary_deliverable": {
      "type": "string",
      "minLength": 1
    },
    "change_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "paths", "cases"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/repositoryPath"
            }
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "allowed_write_paths": {
      "$ref": "#/$defs/repositoryPathList"
    },
    "forbidden_paths": {
      "$ref": "#/$defs/repositoryPathList"
    },
    "impact_cone": {
      "$ref": "#/$defs/repositoryPathList"
    },
    "test_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focused", "affected", "full", "full_triggers", "reuse_keys"],
      "properties": {
        "focused": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "affected": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "full": {
          "type": "string",
          "minLength": 1
        },
        "full_triggers": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "reuse_keys": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "candidate_head",
              "dependency_fingerprint",
              "test_config_fingerprint",
              "environment_fingerprint"
            ]
          }
        }
      }
    },
    "max_repair_rounds": {
      "const": 1
    },
    "bundle_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    },
    "repositoryPathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
