# Godot engine cache
.godot/
*.import
# 地形批准记录校验这些导入参数，需随素材交付。
!/assets/prototype/battlefield_courtyard/*.png.import
export_presets.cfg

# Engine / dev-environment generated files
# Add entries here when new tools generate disposable files
*.uid
.tmp_godot_mcp_*.txt

# Python helper and test bytecode
__pycache__/

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
*.swp
*.swo

# AI Agent runtime config (local only)
.claude/*
!.claude/skills/
.cursor/*
!.cursor/rules/
.mcp.json
opencode.json
.omc/
.codex/project/sot-roots.local.toml
.sot/memory/
# Note: CLAUDE.md / AGENTS.md / .cursorrules / .claude/skills/ / .cursor/rules/ are project-level AI instructions, tracked in VCS
# Note: .mcp.json / opencode.json contains API keys, never commit

# Editor workspace data
/data/talent-tree/

# Windows reserved device names
nul

# handoff skill — local KB-pointer marker + fallback handoff dir (transient, never commit)
.handoff-config
.handoff/
.specify/workflows/runs/

# CI 与本地测试运行日志（tools/ci/run_godot_tests.sh）
.ci-logs/

# 任务工作树（scripts/codex/sot-worktree.ps1 在仓库内创建）
/.worktrees/

# 任务临时文件与清理前保留的 ignored 内容
/.tmp/
