%%{init: {'theme': 'base', 'themeVariables': { 'fontSize': '14px' }}}%%

graph TB
  subgraph battle_core["核心战斗系统"]
    T01["01-回合系统<br/>速度轮动 / 先制 / Buff时机"]
    T02["02-网格与地图<br/>三层地形 / 攻击线 / 寻路 / ZOC"]
    T03["03-战斗计算<br/>乘区分层 / 双轴伤害类型 / 反击 / 追击"]
    T04["04-技能与射程<br/>射程模式 / AOE / 附加效果"]
    TVS["视野系统<br/>（待建）"]
  end

  subgraph characters["角色与成长"]
    T05["05-职业系统<br/>8职业+16转职 / 反击 / 追击"]
    T12["12-天赋树<br/>Run内重置 / 转职节点<br/>（待建）"]
    T06["06-敌人与AI<br/>AI行为 / 分批入场 / Boss"]
  end

  subgraph roguelite["Roguelite框架"]
    T07["07-Run循环<br/>3大关×10小关 / Meta横向解锁"]
    T11["11-城镇建设<br/>6种战场建筑 / 耐久 / 修复"]
  end

  subgraph tech["技术架构"]
    T08["08-联机架构<br/>GameAction / Host-Client"]
    T09["09-数据架构<br/>JSON驱动 / 数据加载"]
  end

  T10["10-开发里程碑<br/>Phase 1~6"]

  %% 核心战斗内部关系
  T01 -- "行动顺序/Buff时机" --> T03
  T02 -- "地形修正/攻击线" --> T03
  T04 -- "技能倍率/伤害类型" --> T03
  T01 -- "回合推进 → 冷却恢复" --> T04

  %% 角色 ↔ 战斗
  T05 -- "属性/格挡/反击/追击" --> T03
  T05 -- "class_tags/武器限制" --> T04
  T12 -- "被动/技能/转职" --> T05
  T06 -- "AI → 移动/寻路" --> T02
  T06 -- "AI → 攻击/技能" --> T03

  %% Roguelite ↔ 战斗
  T07 -- "关卡 → 地图/敌人" --> T02
  T07 -- "关卡 → 敌人波次" --> T06
  T07 -- "奖励/天赋点" --> T12
  T07 -- "Meta解锁 → 职业/遗物/建筑" --> T05
  T11 -- "战场建筑 → 三层叠加" --> T02
  T11 -- "建筑效果 → 最终伤害增减" --> T03
  T11 -- "class_tags匹配" --> T05
  T07 -- "准备阶段 → 建设/修复" --> T11

  %% 技术架构
  T08 -- "GameAction" --> T01
  T08 -- "同步" --> T07
  T09 -. "JSON加载" .-> T02
  T09 -. "JSON加载" .-> T04
  T09 -. "JSON加载" .-> T05
  T09 -. "JSON加载" .-> T06
  T09 -. "JSON加载" .-> T11

  T10 -. "开发计划" .-> battle_core
  T10 -. "" .-> characters
  T10 -. "" .-> roguelite

  %% 样式
  classDef core fill:#4A90D9,stroke:#2C5F8A,color:#fff
  classDef char fill:#7B68EE,stroke:#5A4FCF,color:#fff
  classDef rogue fill:#E8833A,stroke:#C06A2E,color:#fff
  classDef techStyle fill:#50C878,stroke:#3A9D5C,color:#fff
  classDef milestone fill:#888,stroke:#666,color:#fff
  classDef planned fill:#555,stroke:#444,color:#fff,stroke-dasharray: 5 5

  class T01,T02,T03,T04 core
  class T05,T06,T12 char
  class T07,T11 rogue
  class T08,T09 techStyle
  class T10 milestone
  class TVS planned
