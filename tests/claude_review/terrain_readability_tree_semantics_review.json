  "criteriaResults": [
    {
      "criterion": "dark_side_geometry",
      "verdict": "PASS",
      "evidence": "v3原图、C1-C7叠加、D1-D9暗侧叠加及局部v2/v3放大对照：D1-D9分别落在C1-C6叶簇的下缘或侧面阴影叶面，边界跟随成片叶面。区域内保留了纹理自然起伏，没有按亮度筛掉局部亮叶点；C7裸枝、主干和树根没有被标成叶片暗侧。九个闭合多边形均对应可见叶片区域。"
    },
    {
      "criterion": "outline_absence",
      "verdict": "PASS",
      "evidence": "v3原PNG及叠加图可见叶缘、叶簇间隙和枝干局部暗边；其宽度与走向随叶片重叠和枝干体积变化，没有围绕叶簇或整冠独立连续、均匀的强描边带。空outline数组与可见图像相符，批准的是这项狭义缺席分类。"
    }
  ],
  "image_evidence": [
    {
      "item": "forest-tree-v3.png原始RGBA",
      "observation": "新图中叶面整体色相变绿、明暗层次有变化；叶簇位置和总体构图与v2对应。主干、分枝与根系保持为木质区域。透明边缘可见低alpha柔和过渡。"
    },
    {
      "item": "tree-r3-review-crown-overlay.png",
      "observation": "C1-C6分别沿着六个可见叶簇，C7沿C1与C3之间冠内裸枝。所有冠区均避开主干根部；枝条和叶簇间空隙按几何边界区分。"
    },
    {
      "item": "tree-r3-review-dark-side-overlay.png",
      "observation": "D1-D9位于各自叶簇的下缘或侧面；没有把C7裸枝、主干或树根圈作暗侧叶面。红色区域是语义区域覆盖显示，不是通过亮度阈值筛选的像素集。"
    },
    {
      "item": "tree-r3-review-dark-side-zoom.png",
      "observation": "九个区域的v2/v3并排局部图中，叶片暗侧关系在颜色改变后仍能辨认；所见的叶片纹理起伏不改变区域按叶面几何分类。"
    },
    {
      "item": "forest-tree-v2.png参考原图",
      "observation": "旧图也有低alpha柔边；与v3并看没有发现新增的外扩实质性光晕或连续描边。"
